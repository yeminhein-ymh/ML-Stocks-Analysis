# Optional separate Alpaca paper account for options pages.
ALPACA_OPTIONS_API_KEY=your_options_paper_key_here
ALPACA_OPTIONS_SECRET_KEY=your_options_paper_secret_here
ALPACA_OPTIONS_ENDPOINT=https://paper-api.alpaca.markets/v2

# Optional future integrations.
